# `grumble setup` manages this for you. To edit by hand, copy to %APPDATA%\Grumble\.env
# System environment variables take priority over this file.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
GRUMBLE_MODEL=
# Optional if you're signed in with the GitHub CLI. Not used until issue filing is built.
GITHUB_TOKEN=
